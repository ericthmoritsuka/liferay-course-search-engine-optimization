# Copy to .env.local. It stays out of Git.

# Where your liferay-learn clone is. Screenshots are written into the
# article's images folder there, so after a run `git status` in liferay-learn
# lists what changed. Without this they are written beside the tests instead.
LIFERAY_LEARN_DIR=/home/me/projects/liferay-learn

# The bundle under test.
LIFERAY_URL=http://localhost:8080
