# Copy to .env.local. It stays out of Git.

# Where your liferay-learn clone is. Screenshots are written into the
# article's images folder there, so after a run `git status` in liferay-learn
# lists what changed. Without this they are written beside the tests instead.
LIFERAY_LEARN_DIR=/path/to/liferay-learn

# The bundle under test.
LIFERAY_URL=http://localhost:8080

# The page the exercises start from, which is this course's own home page.
#
# Check it in a browser before a run. Liferay answers an unknown path with a
# 404 rendered inside the Guest site rather than an error, and the Guest site
# here carries the same company name - so a wrong value looks like a working
# instance whose menus are all missing applications. Getting this wrong once
# cost a run of 71 tests, 21 of which failed for no other reason. signIn now
# refuses to continue when it lands on a 404, and names this variable.
COURSE_HOME=/web/clarity/home

# The password the course README prints for its Clarity users.
CLARITY_PASSWORD=learn
